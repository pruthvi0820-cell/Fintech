# Copy to .env and fill in. Never commit .env.

# Anthropic credentials. Optional if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Model + reasoning depth used for analysis summaries.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Seconds before an LLM request is abandoned (SDK retries on top of this).
LLM_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
