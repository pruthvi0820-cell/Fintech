# Copy to .env and edit. Never commit .env.

# ---- Which model writes the analysis ----------------------------------------
# ollama        = free, runs on your own computer (default)
# openai_compat = any OpenAI-compatible API (Groq, Gemini, LM Studio...)
# anthropic     = Claude via paid API
FIN_AGENT_PROVIDER=ollama

# Model name. Ollama: whatever you pulled (e.g. qwen3:8b, qwen3:4b, llama3.1:8b).
FIN_AGENT_MODEL=qwen3:8b

# Let reasoning models (qwen3) think before answering. Default false: thinking is slow on a laptop
# and can use the whole token budget. Ollama only (sends reasoning_effort="none" when false).
FIN_AGENT_THINK=false

# For ollama the default URL is fine. For openai_compat set the provider's URL + key.
# FIN_AGENT_LLM_URL=http://localhost:11434/v1
# FIN_AGENT_LLM_API_KEY=

# Only needed when FIN_AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# FIN_AGENT_MODEL=claude-sonnet-5-5

# --- Phone alerts (optional, free): python scripts/alerts_runner.py ---
# Token from @BotFather in Telegram (/newbot). Keep it secret: anyone with it controls your bot.
# FIN_AGENT_TELEGRAM_TOKEN=123456789:ABC...
# Your chat id: send your bot a message, then run  python scripts/alerts_runner.py --setup
# FIN_AGENT_TELEGRAM_CHAT_ID=123456789

# --- Zerodha read-only (optional, free "Kite Connect Personal" app): python scripts/zerodha.py --login ---
# From developers.kite.trade -> your app. Keep the secret secret: never paste it anywhere else.
# FIN_AGENT_KITE_API_KEY=
# FIN_AGENT_KITE_API_SECRET=

# --- Real orders (Step 7). OFF unless you set this yourself. Every order still needs your typed approval
# in FinTray, passes the risk engine, and Zerodha needs your registered static IP for API orders.
# FIN_AGENT_LIVE_TRADING=true

# --- Angel One read-only (optional, free SmartAPI): python scripts/angelone.py --login ---
# From smartapi.angelone.in -> create an app. Your PIN and the 6-digit code are typed at login, never stored.
# FIN_AGENT_ANGEL_API_KEY=
# FIN_AGENT_ANGEL_CLIENT_CODE=

# MetaTrader 5 (XM demo, read-only; Windows). Only if two MT5s are installed or the check says
# "Authorization failed": the full path of the terminal64.exe you log in to.
# FIN_AGENT_MT5_PATH=C:\Program Files\XM Global MT5\terminal64.exe
# XM server clock vs UTC, only if `python scripts/mt5.py --check` can't measure it (market closed): 2 winter, 3 summer
# FIN_AGENT_MT5_UTC_OFFSET=3
# Gold's name in your MT5, only if FinTray can't find it (XM: GOLD; MetaQuotes-Demo: XAUUSD)
# FIN_AGENT_MT5_GOLD_SYMBOL=XAUUSD

# Where prices come from. live (default): only Angel One (India) and MetaTrader 5 (gold, currencies,
# world indices, US stocks); never Yahoo. yahoo: Yahoo Finance (free, often ~15 min late).
# FIN_AGENT_PRICES=live
