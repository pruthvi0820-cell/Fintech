# Copy to .env and edit. Never commit .env.

# ---- Which model writes the analysis ----------------------------------------
# ollama        = free, runs on your own computer (default)
# openai_compat = any OpenAI-compatible API (Groq, Gemini, LM Studio...)
# anthropic     = Claude via paid API
FIN_AGENT_PROVIDER=ollama

# Model name. Ollama: whatever you pulled (e.g. qwen3:8b, qwen3:4b, llama3.1:8b).
FIN_AGENT_MODEL=qwen3:8b

# For ollama the default URL is fine. For openai_compat set the provider's URL + key.
# FIN_AGENT_LLM_URL=http://localhost:11434/v1
# FIN_AGENT_LLM_API_KEY=

# Only needed when FIN_AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# FIN_AGENT_MODEL=claude-sonnet-5-5
