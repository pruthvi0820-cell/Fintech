# Copy to terraform.tfvars (git-ignored) and fill in.
admin_cidr          = "203.0.113.7/32"          # your public IP + /32 (search "what is my IP")
ssh_public_key_path = "~/.ssh/id_ed25519.pub"   # create one with: ssh-keygen -t ed25519
